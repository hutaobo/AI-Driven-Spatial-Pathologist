# Preserve the existing spatho OpenAI option separately.
# Workflows can still use `pathology_review_backend=openai` unchanged.

LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=openai/gpt-oss-120b

EMBED_BASE_URL=http://embedder:80
EMBED_MODEL=BAAI/bge-m3

RERANK_BASE_URL=http://reranker:80
RERANK_MODEL=BAAI/bge-reranker-v2-m3

VECTOR_DB=qdrant
QDRANT_BASE_URL=http://qdrant:6333
QDRANT_COLLECTION=pathology_reference

DEFAULT_TOP_K=6
STRICT_JSON=true
REQUEST_TIMEOUT_SECONDS=30
MAX_CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=120
